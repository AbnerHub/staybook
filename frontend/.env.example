# URL base del backend FastAPI de StayBook.
# El prefijo VITE_ es obligatorio para exponer la variable al cliente (Vite).
# Copia este archivo a .env (o .env.local) y ajusta el valor si es necesario.
# Si no se define, el frontend usa el fallback http://127.0.0.1:8000.
VITE_API_BASE_URL=http://127.0.0.1:8000
